# ─── Sito ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Dominio pubblico: usato per canonical, robots.txt, sitemap.xml e CORS.
SITE_URL=https://www.nuovacopertura.it

# Local dev (Pelican imposta SERVER_PORT automaticamente dalla porta allocata)
PORT=3000
HOST=0.0.0.0

# ─── Form "Richiedi preventivo" ───────────────────────────────────────────────
# Casella che riceve i lead.
CONTACT_TO=info@nuovacopertura.it

# Origini autorizzate a chiamare /api/contact (separate da virgola).
# Se vuoto vengono derivate da SITE_URL. Serve a impedire che altri siti
# usino il server come relay per inviare mail dalla tua casella.
ALLOWED_ORIGINS=https://www.nuovacopertura.it,https://nuovacopertura.it

# Max invii per IP al minuto (default 5) e tetto globale orario (default 60).
RATE_MAX=5
RATE_GLOBAL_MAX=60

# Numero di reverse proxy davanti all'app: conta gli hop, non "c'e' un proxy si/no".
#   2 = Cloudflare -> Nginx Proxy Manager -> app   <-- setup di yrb4g.com
#   1 = un solo proxy davanti
#   0 = app esposta direttamente (ignora X-Forwarded-For)
# Troppo basso: il rate limit raggruppa i visitatori sotto l'IP del proxy.
# Troppo alto: diventa aggirabile falsificando X-Forwarded-For.
TRUST_PROXY=2

# ─── SMTP (Zoho Mail EU — SMTPS porta 465) ────────────────────────────────────
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nuovacopertura.it
SMTP_PASS=YOUR_APP_PASSWORD_HERE
SMTP_FROM_NAME=Preventivo
SMTP_FROM="Preventivo <info@nuovacopertura.it>"
# SMTP_DEBUG=1   # abilita il log verboso della sessione SMTP

# ─── Diagnostica ──────────────────────────────────────────────────────────────
# In produzione /api/health restituisce solo {"ok":true}.
# Con questo token ottieni il dettaglio SMTP:
#   curl -H "x-health-token: ..." https://.../api/health
HEALTH_TOKEN=cambia-questo-token
